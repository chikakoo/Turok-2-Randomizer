InvincibleFade
{
    $color ({0 0 0}, 0)
    $fade_color ({255 0 0}, 90, 15.0)
    $fade_color ({255 0 0}, 0, 15.0)
    $color ({0 0 0}, 0)
    $wait (0.25)
}

InvincibleFlash
{
    $color ({0 0 0}, 0)
    $fade_color ({255 255 255}, 255, 2.0)
    $fade_color ({255 255 255}, 0, 8.0)
    $color ({0 0 0}, 0)
    $wait (0.25)
}